# =================================================================
# Project Vaani - Environment Configuration
# =================================================================

# Frontend WebSocket Target (leave empty if using Nginx reverse proxy on same domain)
# For Vercel/Render separate deployment, set to wss://your-backend.onrender.com/ws/stream
NEXT_PUBLIC_VAANI_WS_URL=

# Backend Host and Port
VAANI_HOST=0.0.0.0
VAANI_PORT=8000
VAANI_RELOAD=false

# Model Directory
VAANI_MODEL_DIR=models/pretuned/dpdfnet
